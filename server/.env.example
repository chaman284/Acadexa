# Server Configuration
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# Database Connection (Supabase PostgreSQL / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?schema=public"

# Auth Tokens
JWT_SECRET="your_secure_jwt_secret_key"
JWT_EXPIRES_IN="7d"

# Optional AI Question Generation
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# Model used for document-based MCQ generation (easy to swap)
GEMINI_DOCUMENT_MODEL="gemini-3.5-flash-lite"
# Optional: only shown in the tutor's "who are you?" answer when explicitly set
MODEL_NAME=""

# Tutor retrieval tuning
TUTOR_DEBUG="false"
TUTOR_RELEVANCE_THRESHOLD="0.35"
TUTOR_MAX_CHUNKS="3"
# Set to false to keep embedding calls fully local
TUTOR_USE_GEMINI_EMBEDDINGS="true"

# Faculty skill-gap digest (in-app notifications only)
SKILL_GAP_DIGEST_ENABLED="true"
SKILL_GAP_DIGEST_HOUR="8"
SKILL_GAP_DIGEST_MINUTE="0"
SKILL_GAP_DIGEST_TIMEZONE="Asia/Kolkata"

# Supabase Server Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SECRET_KEY="your-secret-key"
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
